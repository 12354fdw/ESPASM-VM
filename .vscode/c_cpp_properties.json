{
  "configurations": [
    {
      "name": "ESP-IDF",
      "compilerPath": "${config:idf.pythonBinPath}", 
      "compileCommands": "${config:idf.buildPath}/compile_commands.json",
      "intelliSenseMode": "linux-gcc-arm64", 
      "cppStandard": "c++20",
      "cStandard": "c11",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}